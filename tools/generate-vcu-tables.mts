// Generates emcool's copy of the reference implementation's VCU parameter tables from its own
// modules: every parameter table the catalogue carries (src/vcu/table-catalog.ts, rebuilt by its
// own parameterTableFor() from params.ecf plus each table's delta, fingerprint-checked there), and
// the A8 firmware rows (src/vcu/a8-firmware-rows.ts). Names and sections are pooled, and tables
// with identical content share one array, so the 29 tables cost about 70 KB of flash.
//
//   node tools/generate-vcu-tables.mts <reference checkout> [--check]

import { readFile, writeFile, mkdir } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

interface VcuParameter {
  index: number;
  name: string;
  type: "BYTE" | "WORD" | "BOOL" | "DWORD";
  signed: boolean;
  micro: "A8" | "A9";
  section: string | null;
  otherBikeValue: number | null;
}

const emcoolRoot = join(dirname(fileURLToPath(import.meta.url)), "..");
const outputPath = join(emcoolRoot, "components/emcool_vcu/src/tables.gen.cpp");

const [referenceDirectory, ...flags] = process.argv.slice(2);
if (!referenceDirectory) {
  console.error("usage: node tools/generate-vcu-tables.mts <reference checkout> [--check]");
  process.exit(2);
}
const checkOnly = flags.includes("--check");
const load = (path: string) => import(pathToFileURL(join(referenceDirectory, path)).href);

const catalogue = await load("src/vcu/table-catalog.ts");
const paramTable = await load("src/vcu/param-table.ts");
const firmware = await load("src/vcu/a8-firmware-rows.ts");

const literal = (text: string) => JSON.stringify(text);
const types: Record<VcuParameter["type"], string> = {
  BOOL: "StorageType::kBool",
  BYTE: "StorageType::kByte",
  WORD: "StorageType::kWord",
  DWORD: "StorageType::kDword",
};

const names: string[] = [];
const nameIds = new Map<string, number>();
const nameId = (name: string) => {
  if (!nameIds.has(name)) {
    nameIds.set(name, names.length);
    names.push(name);
  }
  return nameIds.get(name)!;
};
const sections: string[] = [];
const sectionId = (section: string | null) => {
  if (section === null) return "kNoSection";
  if (!sections.includes(section)) sections.push(section);
  return String(sections.indexOf(section));
};

const tableTypes = catalogue.KNOWN_TABLE_TYPES as number[];
const arrays: string[] = [];
const arrayIds = new Map<string, number>();
const tables: string[] = [];
for (const tableType of tableTypes) {
  const table = catalogue.parameterTableFor(tableType) as {
    exportStamp: string;
    fingerprint: string;
    parameters: VcuParameter[];
  };
  const rows = table.parameters.map(parameter => {
    if (parameter.otherBikeValue !== null && !Number.isInteger(parameter.otherBikeValue)) {
      throw new Error(`table ${tableType} index ${parameter.index}: a fractional value no int32 can hold`);
    }
    return (
      `{${parameter.index}, ${nameId(parameter.name)}, ${sectionId(parameter.section)}, ${types[parameter.type]}, ` +
      `Micro::k${parameter.micro}, ${parameter.signed}, ${parameter.otherBikeValue !== null}, ` +
      `${parameter.otherBikeValue ?? 0}}`
    );
  });
  const key = rows.join("\n");
  if (!arrayIds.has(key)) {
    arrayIds.set(key, arrays.length);
    arrays.push(`constexpr VcuParameter kRows${arrays.length}[] = {\n    ${rows.join(",\n    ")},\n};`);
  }
  tables.push(
    `    {${tableType}, ${literal(table.exportStamp)}, ${literal(table.fingerprint)}, kRows${arrayIds.get(key)}},`
  );
}

const firmwareRows = (firmware.a8FirmwareRows() as { index: number; type: VcuParameter["type"]; known: string | null }[]).map(
  row => `    {${row.index}, ${types[row.type]}, ${row.known === null ? "nullptr" : literal(row.known)}},`
);

const content = `// Generated by tools/generate-vcu-tables.mts from the reference implementation's
// src/vcu/table-catalog.ts (every table rebuilt by its own parameterTableFor()) and
// src/vcu/a8-firmware-rows.ts. Do not edit.

#include "emcool/vcu/tables.hpp"

namespace emcool::vcu {

namespace {

constexpr std::uint8_t kNoSection = 0xff;

constexpr const char* kNames[] = {
${names.map(name => `    ${literal(name)},`).join("\n")}
};

constexpr const char* kSections[] = {
${sections.map(section => `    ${literal(section)},`).join("\n")}
};

${arrays.join("\n\n")}

constexpr VcuParameterTable kTables[] = {
${tables.join("\n")}
};

constexpr A8FirmwareRow kFirmwareRows[] = {
${firmwareRows.join("\n")}
};

}  // namespace

const char* parameterName(std::uint16_t nameId) { return kNames[nameId]; }
const char* parameterSection(std::uint8_t sectionId) { return sectionId == kNoSection ? nullptr : kSections[sectionId]; }
std::span<const VcuParameterTable> parameterTables() { return kTables; }
std::span<const A8FirmwareRow> a8FirmwareRows() { return kFirmwareRows; }

static_assert(${paramTable.DEFAULT_TABLE_TYPE} == kDefaultTableType, "the reference's DEFAULT_TABLE_TYPE");
static_assert(${catalogue.BASE_TABLE_TYPE} == kBaseTableType, "the reference's BASE_TABLE_TYPE");

}  // namespace emcool::vcu
`;

const existing = await readFile(outputPath, "utf-8").catch(() => null);
if (existing !== content) {
  if (checkOnly) {
    console.error(`stale: ${outputPath} — run tools/generate-vcu-tables.mts`);
    process.exit(1);
  }
  await mkdir(dirname(outputPath), { recursive: true });
  await writeFile(outputPath, content);
  console.log(`wrote ${outputPath}`);
}
console.log(
  `vcu tables: ${tableTypes.length} tables (${arrays.length} distinct), ${names.length} names, ` +
    `${firmwareRows.length} A8 firmware rows ${checkOnly ? "up to date" : "generated"}`
);
