// Generates emcool's copies of the reference implementation's static diagnostic data from its own
// modules, so the transcribed tables (154 trouble codes, 944 infokey references) are the
// reference's data rather than a hand copy that drifts:
//   - components/emcool_obd/src/dtc_table.gen.cpp: src/diagnostics/dtc-table.ts, for naming
//     the codes /stored-dtcs serves
//   - components/emcool_obd/src/static_bodies.gen.cpp: the exact bodies the reference's
//     /dtc-table and /fault-infokeys serve, built by those endpoints' own buildPayload()
//   - components/emcool_obd/src/infokeys.gen.cpp: src/diagnostics/infokey-table.ts' 120 fields and
//     fault-infokeys.ts' per-fault shortlists, for decoding freeze frames
// Run it again whenever the reference's tables change; --check fails if the output is stale.
//
//   node tools/generate-diagnostic-tables.mts <reference checkout> [--check]

import { readFile, writeFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

interface DtcTableEntry {
  component: number;
  symptom: number;
  obdCode: string;
  name: string;
  description: string;
  illuminatesMil: boolean | null;
}

const emcoolRoot = join(dirname(fileURLToPath(import.meta.url)), "..");
const outputDirectory = join(emcoolRoot, "components/emcool_obd/src");

const [referenceDirectory, ...flags] = process.argv.slice(2);
if (!referenceDirectory) {
  console.error("usage: node tools/generate-diagnostic-tables.mts <reference checkout> [--check]");
  process.exit(2);
}
const checkOnly = flags.includes("--check");
const load = (path: string) => import(pathToFileURL(join(referenceDirectory, path)).href);

const dtcTable = (await load("src/diagnostics/dtc-table.ts")).DTC_TABLE as DtcTableEntry[];
const infokeyTable = (await load("src/diagnostics/infokey-table.ts")).INFOKEY_TABLE as {
  id: number;
  name: string;
  unit: string;
  datatype: string;
  equation: string;
  refusedScaling: string | null;
}[];
const faultInfokeys = (await load("src/diagnostics/fault-infokeys.ts")).FAULT_INFOKEYS as {
  component: number;
  symptom: number;
  serviceToolObdCode: string;
  infokeys: readonly number[];
}[];
const dtcTableBody = JSON.stringify((await load("src/http/dtc-table.ts")).buildPayload());
const faultInfokeysBody = JSON.stringify((await load("src/http/fault-infokeys.ts")).buildPayload());

const header = (sources: string) =>
  `// Generated by tools/generate-diagnostic-tables.mts from the reference implementation's ${sources}. Do not edit.\n`;

// A C++ string literal holding exactly `text`'s UTF-8 bytes.
function literal(text: string): string {
  let out = '"';
  for (const character of text) {
    const code = character.codePointAt(0)!;
    if (character === '"' || character === "\\") {
      out += "\\" + character;
    } else if (code < 0x20 || code === 0x7f) {
      out += `\\x${code.toString(16).padStart(2, "0")}""`;
    } else {
      out += character;
    }
  }
  return out + '"';
}

// Long text as adjacent literals, a line each, so the file stays readable and diffable.
function longLiteral(text: string, indent: string): string {
  // By code point, so a character outside the BMP is never split between two literals.
  const characters = Array.from(text);
  const pieces: string[] = [];
  for (let offset = 0; offset < characters.length; offset += 100) {
    pieces.push(indent + literal(characters.slice(offset, offset + 100).join("")));
  }
  return pieces.join("\n");
}

function mil(value: boolean | null): string {
  if (value === null) return "Mil::kUnknown";
  return value ? "Mil::kOn" : "Mil::kOff";
}

function renderDtcTable(): string {
  const rows = dtcTable.map(
    entry =>
      `    {${entry.component}, ${entry.symptom}, ${literal(entry.obdCode)}, ${literal(entry.name)}, ` +
      `${literal(entry.description)}, ${mil(entry.illuminatesMil)}},`
  );
  return (
    header("src/diagnostics/dtc-table.ts") +
    `
#include "emcool/obd/dtc_table.hpp"

namespace emcool::obd {

namespace {

constexpr DtcTableEntry kTable[] = {
${rows.join("\n")}
};

}  // namespace

std::span<const DtcTableEntry> dtcTable() { return kTable; }

}  // namespace emcool::obd
`
  );
}

function renderStaticBodies(): string {
  return (
    header("src/http/dtc-table.ts and src/http/fault-infokeys.ts, each body by its buildPayload()") +
    `
#include "emcool/obd/static_bodies.hpp"

namespace emcool::obd {

namespace {

// ${Buffer.byteLength(dtcTableBody)} bytes.
constexpr char kDtcTable[] =
${longLiteral(dtcTableBody, "    ")};

// ${Buffer.byteLength(faultInfokeysBody)} bytes.
constexpr char kFaultInfokeys[] =
${longLiteral(faultInfokeysBody, "    ")};

}  // namespace

std::string_view dtcTableBody() { return {kDtcTable, sizeof kDtcTable - 1}; }
std::string_view faultInfokeysBody() { return {kFaultInfokeys, sizeof kFaultInfokeys - 1}; }

}  // namespace emcool::obd
`
  );
}

const datatypes: Record<string, string> = {
  uint8_t: "InfokeyDatatype::kUint8",
  int8_t: "InfokeyDatatype::kInt8",
  uint16_t: "InfokeyDatatype::kUint16",
  int16_t: "InfokeyDatatype::kInt16",
  uint32_t: "InfokeyDatatype::kUint32",
};
const equations: Record<string, string> = {
  "": "InfokeyEquation::kIdentity",
  "f(x)=x*0.1": "InfokeyEquation::kTimes0_1",
  "f(x)=x*0.05625": "InfokeyEquation::kTimes0_05625",
  "(X/2)-40": "InfokeyEquation::kHalfMinus40",
  "f(x)=x@&255": "InfokeyEquation::kMalformed",
};

function renderInfokeys(): string {
  const fields = infokeyTable.map(field => {
    if (!(field.datatype in datatypes) || !(field.equation in equations)) {
      throw new Error(`infokey ${field.id}: unhandled datatype ${field.datatype} or equation ${field.equation}`);
    }
    return (
      `    {${field.id}, ${literal(field.name)}, ${literal(field.unit)}, ${datatypes[field.datatype]}, ` +
      `${literal(field.equation)}, ${equations[field.equation]}, ` +
      `${field.refusedScaling === null ? "nullptr" : literal(field.refusedScaling)}},`
    );
  });
  const lists: string[] = [];
  const shortlists = faultInfokeys.map((entry, index) => {
    // A fault whose shortlist is empty gets an empty span: C++ has no zero-length arrays.
    if (entry.infokeys.length === 0) return `    {${entry.component}, ${entry.symptom}, ${literal(entry.serviceToolObdCode)}, {}},`;
    lists.push(`constexpr std::uint8_t kList${index}[] = {${entry.infokeys.join(", ")}};`);
    return `    {${entry.component}, ${entry.symptom}, ${literal(entry.serviceToolObdCode)}, kList${index}},`;
  });
  return (
    header("src/diagnostics/infokey-table.ts and src/diagnostics/fault-infokeys.ts") +
    `
#include "emcool/obd/infokeys.hpp"

namespace emcool::obd {

namespace {

constexpr InfokeyField kFields[] = {
${fields.join("\n")}
};

${lists.join("\n")}

constexpr FaultInfokeys kShortlists[] = {
${shortlists.join("\n")}
};

}  // namespace

std::span<const InfokeyField> infokeyTable() { return kFields; }
std::span<const FaultInfokeys> faultInfokeysTable() { return kShortlists; }

}  // namespace emcool::obd
`
  );
}

const generated = new Map([
  [join(outputDirectory, "dtc_table.gen.cpp"), renderDtcTable()],
  [join(outputDirectory, "static_bodies.gen.cpp"), renderStaticBodies()],
  [join(outputDirectory, "infokeys.gen.cpp"), renderInfokeys()],
]);

let stale = false;
for (const [path, content] of generated) {
  const existing = await readFile(path, "utf-8").catch((error: NodeJS.ErrnoException) => {
    if (error.code === "ENOENT") return null;
    throw error;
  });
  if (existing === content) continue;
  if (checkOnly) {
    console.error(`stale: ${path} — run tools/generate-diagnostic-tables.mts`);
    stale = true;
    continue;
  }
  await writeFile(path, content);
  console.log(`wrote ${path}`);
}
if (stale) process.exit(1);
console.log(
  `diagnostic tables: ${dtcTable.length} trouble codes, /dtc-table ${Buffer.byteLength(dtcTableBody)} bytes, ` +
    `/fault-infokeys ${Buffer.byteLength(faultInfokeysBody)} bytes ${checkOnly ? "up to date" : "generated"}`
);
