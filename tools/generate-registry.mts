// Generates the C++ signal registry from cool-eva's own src/can/registry.ts, so emcool's 500+
// definitions (units, groups, deadbands, bounds) are cool-eva's data rather than a hand copy
// that drifts. Run it again whenever cool-eva's registry changes; --check fails if the
// committed output is stale.
//
//   node tools/generate-registry.mts <cool-eva checkout> [--check]

import { readFile, writeFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

interface CoolEvaSignalDef {
  key: string;
  unit: string;
  group: string;
  source: "stream" | "poll" | "sensor";
  deadband?: number;
  onDemand?: true;
  bounds?: readonly [number, number];
  unbounded?: "counter" | "raw-word" | "index" | "unresolved";
}

const SOURCE_ENUM: Record<CoolEvaSignalDef["source"], string> = {
  stream: "SignalSource::kStream",
  poll: "SignalSource::kPoll",
  sensor: "SignalSource::kSensor",
};

const UNBOUNDED_ENUM: Record<NonNullable<CoolEvaSignalDef["unbounded"]>, string> = {
  counter: "Unbounded::kCounter",
  "raw-word": "Unbounded::kRawWord",
  index: "Unbounded::kIndex",
  unresolved: "Unbounded::kUnresolved",
};

const emcoolRoot = join(dirname(fileURLToPath(import.meta.url)), "..");
const sourcePath = join(emcoolRoot, "components/emcool_signals/src/registry.gen.cpp");
const headerPath = join(emcoolRoot, "components/emcool_signals/include/emcool/signals/registry_size.gen.hpp");

const [coolEvaDirectory, ...flags] = process.argv.slice(2);
if (!coolEvaDirectory) {
  console.error("usage: node tools/generate-registry.mts <cool-eva checkout> [--check]");
  process.exit(2);
}
const checkOnly = flags.includes("--check");

const registryModule = await import(pathToFileURL(join(coolEvaDirectory, "src/can/registry.ts")).href);
const signals = [...(registryModule.SIGNALS as CoolEvaSignalDef[])].sort((left, right) =>
  left.key < right.key ? -1 : left.key > right.key ? 1 : 0
);

const generated = new Map([
  [sourcePath, renderSource(signals)],
  [headerPath, renderHeader(signals.length)],
]);

let stale = false;
for (const [path, content] of generated) {
  const existing = await readFile(path, "utf-8").catch((error: NodeJS.ErrnoException) => {
    if (error.code === "ENOENT") {
      return null;
    }
    throw error;
  });
  if (existing === content) {
    continue;
  }
  if (checkOnly) {
    console.error(`stale: ${path} — run tools/generate-registry.mts`);
    stale = true;
    continue;
  }
  await writeFile(path, content);
  console.log(`wrote ${path}`);
}
if (stale) {
  process.exit(1);
}
console.log(`registry: ${signals.length} signals ${checkOnly ? "up to date" : "generated"}`);

function renderSource(sortedSignals: CoolEvaSignalDef[]): string {
  const rows = sortedSignals.map(renderRow).join("\n");
  return `// GENERATED by tools/generate-registry.mts from cool-eva src/can/registry.ts — do not edit.

#include "emcool/signals/registry.hpp"

namespace emcool::signals {

namespace {

// Sorted by key (byte order), which findSignal's binary search relies on.
constexpr SignalDef kSignals[] = {
${rows}
};

static_assert(sizeof(kSignals) / sizeof(kSignals[0]) == kSignalCount);

}  // namespace

std::span<const SignalDef> signalRegistry() { return kSignals; }

}  // namespace emcool::signals
`;
}

function renderHeader(signalCount: number): string {
  return `// GENERATED by tools/generate-registry.mts from cool-eva src/can/registry.ts — do not edit.

#pragma once

#include <cstddef>

namespace emcool::signals {

inline constexpr std::size_t kSignalCount = ${signalCount};

}  // namespace emcool::signals
`;
}

function renderRow(signal: CoolEvaSignalDef): string {
  if (!/^[a-z0-9_]+$/.test(signal.key)) {
    throw new Error(`registry key ${JSON.stringify(signal.key)} is not [a-z0-9_]+; byte-order sorting assumes it is`);
  }
  const bounds = signal.bounds
    ? `true, ${renderNumber(signal.bounds[0])}, ${renderNumber(signal.bounds[1])}`
    : "false, 0, 0";
  const unbounded = signal.unbounded ? UNBOUNDED_ENUM[signal.unbounded] : "Unbounded::kNone";
  return (
    `    {${renderString(signal.key)}, ${renderString(signal.unit)}, ${renderString(signal.group)}, ` +
    `${SOURCE_ENUM[signal.source]}, ${renderNumber(signal.deadband ?? 0)}, ${signal.onDemand === true}, ` +
    `${bounds}, ${unbounded}},`
  );
}

// JSON string escaping is valid C++ for the characters a unit can hold (°, µ, quotes).
function renderString(text: string): string {
  return JSON.stringify(text);
}

// String(number) is the shortest form that round-trips, and C++ parses a decimal literal to
// the nearest double, so the value arrives bit-identical.
function renderNumber(value: number): string {
  if (!Number.isFinite(value)) {
    throw new Error(`registry holds a non-finite number (${value}); render it explicitly`);
  }
  const text = String(value);
  return /[.e]/.test(text) ? text : `${text}.0`;
}
