CONFIG_IDF_TARGET="esp32"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A crash on the bike can't be watched over serial; keep the dump for `idf.py coredump-info`.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Bluetooth LE, NimBLE, one phone as a peripheral. No central or observer role: the bike never
# connects out to another Bluetooth device.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# The phone writes 180-byte frames; iOS offers up to 185, newer phones more.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# The link seals every message itself (AES-GCM keyed from the shared secret), so it needs no
# BLE pairing, and its characteristics carry no encrypt flags.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# Wi-Fi as a station only, beside Bluetooth (WIFI_SSID and ADMIN_PASSWORD turn it on; it is linked in
# either way). Both stacks don't fit at -Og: the fast instruction RAM overflows and the image outgrows
# its 1.875 MB slot. So: build for size, and leave out what joining a home network or phone hotspot
# doesn't need (being an access point, enterprise logins, OWE, and the receive path's IRAM copy).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
