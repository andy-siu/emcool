CONFIG_IDF_TARGET="esp32"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Over-the-air updates boot on trial: a new image that doesn't confirm itself (main/firmware_update.cpp)
# goes back to the old one. A bootloader setting, so it takes one USB flash to turn on.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A crash on the bike can't be watched over serial; keep the dump for `idf.py coredump-info`.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Bluetooth LE, NimBLE, one phone as a peripheral. No central or observer role: the bike never
# connects out to another Bluetooth device.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# The phone writes 180-byte frames; iOS offers up to 185, newer phones more.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# The link seals every message itself (AES-GCM keyed from the shared secret), so it needs no
# BLE pairing, and its characteristics carry no encrypt flags.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# Wi-Fi as a station only, beside Bluetooth (WIFI_SSID and ADMIN_PASSWORD turn it on; it is linked in
# either way). Both stacks don't fit at -Og: the fast instruction RAM overflows and the image outgrows
# its 1.875 MB slot. So: build for size, and leave out what joining a home network or phone hotspot
# doesn't need (being an access point, enterprise logins, OWE, and the receive path's IRAM copy).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# RAM. With Bluetooth, OBD and the card all on, the heap ran out at boot. The controller keeps
# 1 KB per connection it allows, and emcool serves one phone. NimBLE's own buffers are sized
# for many connections; one phone writing 180-byte frames needs far fewer. Wi-Fi uses ESP-IDF's
# "memory saving" profile (api-guides/wifi-driver/wifi-performance-and-power-save.rst), which is
# plenty for the console and the ride-log page.
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
